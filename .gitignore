# Ortam değişkenleri: API anahtarı gibi gizli bilgiler asla repoya girmez
.env
.env.*
!.env.example

# Günlük dosyaları
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# İşletim sistemi ve editör dosyaları
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# Yayın servislerinin yerel ayar klasörleri
.vercel/
.netlify/